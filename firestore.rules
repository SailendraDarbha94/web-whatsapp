rules_version = '2';

// WhatsApp inbox data model:
//   conversations/{waId}
//   conversations/{waId}/messages/{wamid}
//
// All writes happen server-side through the Firebase Admin SDK (webhook +
// send routes), which bypasses these rules entirely. Browsers only ever read,
// and only when signed in. The "mark read" action also goes through an
// authenticated server route, so clients never need write access here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /conversations/{waId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /messages/{wamid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
